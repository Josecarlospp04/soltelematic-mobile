<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
    soltelematic_secure_prefs.xml es EncryptedSharedPreferences: sus valores están cifrados con la
    llave maestra del Android Keystore, que NUNCA se incluye en el backup ni en la transferencia
    de dispositivo. Restaurar ese archivo sin su llave deja el store indescifrable para siempre
    (ver SecureTokenStorage.createPrefs), así que se excluye para que nunca llegue a restaurarse.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="soltelematic_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="soltelematic_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>